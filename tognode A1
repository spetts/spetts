# Dictionary to store the original mute states (for toggle functionality)
original_mute_states = {}

# Store keymaps here to access after registration
addon_keymaps = []

# Function to get materials from selected objects
def get_materials_from_selected_objects():
    materials = set()
    for obj in bpy.context.selected_objects:
        if obj.type in {'MESH', 'CURVE', 'SURFACE', 'META', 'FONT'}:
            for slot in obj.material_slots:
                if slot.material:
                    materials.add(slot.material)
    return materials

# Function to get all materials in the scene
def get_all_materials():
    return set(bpy.data.materials)

# Base operator class with modifier support
class BaseNodeOperator(bpy.types.Operator):
    node_type: bpy.props.StringProperty(default="")  # "BUMP", "NORMAL_MAP", or "" for both

    def execute(self, context):
        # Determine which node types to process based on modifiers
        node_types = []
        if self.node_type:
            node_types.append(self.node_type)
        else:
            if self.is_ctrl:
                node_types.append("NORMAL_MAP")
            elif self.is_alt:
                node_types.append("BUMP")
            else:
                node_types.extend(["BUMP", "NORMAL_MAP"])

        # Process the nodes
        materials = self.get_materials(context)
        for material in materials:
            if material.use_nodes:
                for node in material.node_tree.nodes:
                    if node.type in node_types:
                        self.process_node(node)
        return {'FINISHED'}

    def get_materials(self, context):
        # Override in subclasses to return materials for selected or all objects
        raise NotImplementedError

    def process_node(self, node):
        # Override in subclasses to mute, unmute, or toggle nodes
        raise NotImplementedError

    def invoke(self, context, event):
        # Check for Ctrl or Alt modifiers
        self.is_ctrl = event.ctrl
        self.is_alt = event.alt
        return self.execute(context)

# Operator to Mute Bump and Normal Nodes (Selected Objects)
class MUTE_BUMP_NORMAL_NODES_SELECTED_OT_operator(BaseNodeOperator):
    """Mute all bump and normal nodes in materials of selected objects"""
    bl_idname = "node.mute_bump_normal_nodes_selected"
    bl_label = "Mute Bump and Normal Nodes (Selected)"
    bl_options = {'REGISTER', 'UNDO'}

    def get_materials(self, context):
        return get_materials_from_selected_objects()

    def process_node(self, node):
        node.mute = True

# Operator to Unmute Bump and Normal Nodes (Selected Objects)
class UNMUTE_BUMP_NORMAL_NODES_SELECTED_OT_operator(BaseNodeOperator):
    """Unmute all bump and normal nodes in materials of selected objects"""
    bl_idname = "node.unmute_bump_normal_nodes_selected"
    bl_label = "Unmute Bump and Normal Nodes (Selected)"
    bl_options = {'REGISTER', 'UNDO'}

    def get_materials(self, context):
        return get_materials_from_selected_objects()

    def process_node(self, node):
        node.mute = False

# Operator to Toggle Bump and Normal Nodes (Selected Objects)
class TOGGLE_BUMP_NORMAL_NODES_SELECTED_OT_operator(bpy.types.Operator):
    """Toggle mute state of bump and normal nodes in materials of selected objects"""
    bl_idname = "node.toggle_bump_normal_nodes_selected"
    bl_label = "Toggle Bump and Normal Nodes (Selected)"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        global original_mute_states

        materials = get_materials_from_selected_objects()
        if not original_mute_states:
            # Store the current mute states and mute all nodes
            original_mute_states.clear()  # Clear any previous states
            for material in materials:
                if material.use_nodes:
                    for node in material.node_tree.nodes:
                        if node.type in ('BUMP', 'NORMAL_MAP'):
                            original_mute_states[node] = node.mute
                            node.mute = True
        else:
            # Restore the original mute states for nodes that were not manually muted
            for material in materials:
                if material.use_nodes:
                    for node in material.node_tree.nodes:
                        if node.type in ('BUMP', 'NORMAL_MAP') and node in original_mute_states:
                            if not original_mute_states[node]:  # Only restore if originally unmuted
                                node.mute = False
            # Clear the dictionary after restoring
            original_mute_states.clear()

        return {'FINISHED'}

